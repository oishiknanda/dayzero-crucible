# Copy these into .env.local for development and your hosting provider's environment settings.
# Use a unique, private value for each secret; never commit the real .env.local file.
# Keep the founder code private and use at least 16 random characters.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
FOUNDER_CODE=replace-with-your-private-founder-code

# Career-page agent output (published by .github/workflows/crawl-careers.yml)
# Default is the crawl-data branch of oishiknanda/dayzero-crucible. If the repo is private, also set the token.
# CRAWLED_JOBS_URL=https://raw.githubusercontent.com/oishiknanda/dayzero-crucible/crawl-data/crawled-jobs.json
# CRAWLED_JOBS_TOKEN=

# Rate limits (optional; defaults are in code). Per 10 minutes unless noted.
# RL_CHAT_USER=120  RL_CHAT_ANON=40  RL_NEO_USER=120  RL_NEO_ANON=40  RL_DEBUG_USER=60  RL_DEBUG_ANON=20
# RL_TRANSCRIBE_USER=60  RL_TRANSCRIBE_ANON=15  RL_RESUME_USER=20  RL_RESUME_ANON=15
# RL_SIGNUP_ANON=5 (per hour per IP)  RL_SIGNUP_EMAIL=3 (per hour)  RL_LOGIN_EMAIL=10  RL_LOGIN_IP=100
# REQUIRE_LOGIN_FOR_AI=true   -> interview AI routes need sign-in (Neo stays open). Default off.
# AI_DAILY_CALL_CAP=2000      -> total AI calls per UTC day across everyone. Default unset (no cap).
